<Application x:Class="PCDoc.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PCDoc.App.Converters"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/PcdocStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
      <conv:SeverityToBrushConverter x:Key="SeverityBackground" Suffix=".Background" />
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
      <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
      <conv:EqualsConverter x:Key="Equals" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
