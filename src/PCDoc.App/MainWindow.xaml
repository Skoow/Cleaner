<Window x:Class="PCDoc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PCDoc.App"
        xmlns:views="clr-namespace:PCDoc.App.Views"
        xmlns:sp="clr-namespace:PCDoc.Presentation.SystemPage;assembly=PCDoc.Presentation"
        xmlns:b="clr-namespace:PCDoc.Presentation.Bilan;assembly=PCDoc.Presentation"
        xmlns:st="clr-namespace:PCDoc.Presentation.Settings;assembly=PCDoc.Presentation"
        xmlns:hi="clr-namespace:PCDoc.Presentation.History;assembly=PCDoc.Presentation"
        xmlns:pr="clr-namespace:PCDoc.Presentation;assembly=PCDoc.Presentation"
        xmlns:dg="clr-namespace:PCDoc.Presentation.Diagnostic;assembly=PCDoc.Presentation"
        xmlns:cl="clr-namespace:PCDoc.Presentation.Cleanup;assembly=PCDoc.Presentation"
        xmlns:ap="clr-namespace:PCDoc.Presentation.Apps;assembly=PCDoc.Presentation"
        xmlns:up="clr-namespace:PCDoc.Presentation.Updates;assembly=PCDoc.Presentation"
        xmlns:op="clr-namespace:PCDoc.Presentation.Optimize;assembly=PCDoc.Presentation"
        xmlns:se="clr-namespace:PCDoc.Presentation.Security;assembly=PCDoc.Presentation"
        xmlns:su="clr-namespace:PCDoc.Presentation.Setup;assembly=PCDoc.Presentation"
        Title="PCDoc"
        Icon="Assets/pcdoc.ico"
        Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Chaque ViewModel de page s'affiche avec sa vue. -->
    <DataTemplate DataType="{x:Type sp:SystemPageViewModel}"><views:SystemPage /></DataTemplate>
    <DataTemplate DataType="{x:Type b:BilanPageViewModel}"><views:BilanPage /></DataTemplate>
    <DataTemplate DataType="{x:Type st:SettingsPageViewModel}"><views:SettingsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type hi:HistoryPageViewModel}"><views:HistoryPage /></DataTemplate>
    <DataTemplate DataType="{x:Type dg:DiagnosticPageViewModel}"><views:DiagnosticPage /></DataTemplate>
    <DataTemplate DataType="{x:Type cl:CleanupPageViewModel}"><views:CleanupPage /></DataTemplate>
    <DataTemplate DataType="{x:Type ap:AppsPageViewModel}"><views:AppsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type up:UpdatesPageViewModel}"><views:UpdatesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type op:OptimizePageViewModel}"><views:OptimizePage /></DataTemplate>
    <DataTemplate DataType="{x:Type se:SecurityPageViewModel}"><views:SecurityPage /></DataTemplate>
    <DataTemplate DataType="{x:Type su:SetupPageViewModel}"><views:SetupPage /></DataTemplate>
    <DataTemplate DataType="{x:Type pr:FirstRunViewModel}"><views:FirstRunView /></DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Menu latéral : ListBox = navigation au clavier (flèches) et lecteurs d'écran. -->
    <DockPanel Grid.Column="0" Margin="6,8,6,8">
      <ListBox x:Name="SettingsNav" DockPanel.Dock="Bottom" BorderThickness="0" Background="Transparent"
               AutomationProperties.Name="{app:T Nav.Settings}"
               SelectionChanged="OnBottomNavChanged">
        <ListBoxItem x:Name="SettingsItem" AutomationProperties.Name="{app:T Nav.Settings}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Settings}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
      <ListBox x:Name="MainNav" BorderThickness="0" Background="Transparent"
               AutomationProperties.Name="{app:T Nav.Menu}"
               SelectionChanged="OnMainNavChanged">
        <ListBoxItem x:Name="BilanItem" AutomationProperties.Name="{app:T Nav.Bilan}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Bilan}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="SetupItem" AutomationProperties.Name="{app:T Nav.Setup}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Setup}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="SystemItem" AutomationProperties.Name="{app:T Nav.System}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.System}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="DiagnosticItem" AutomationProperties.Name="{app:T Nav.Diagnostic}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Diagnostic}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="CleanupItem" AutomationProperties.Name="{app:T Nav.Cleanup}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Cleanup}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="AppsItem" AutomationProperties.Name="{app:T Nav.Apps}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Apps}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="UpdatesItem" AutomationProperties.Name="{app:T Nav.Updates}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE895;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Updates}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="OptimizeItem" AutomationProperties.Name="{app:T Nav.Optimize}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE945;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Optimize}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="SecurityItem" AutomationProperties.Name="{app:T Nav.Security}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Security}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="PrivacyItem" AutomationProperties.Name="{app:T Nav.Privacy}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.Privacy}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem x:Name="HistoryItem" AutomationProperties.Name="{app:T Nav.History}">
          <StackPanel Orientation="Horizontal" Margin="4,6">
            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="{app:T Nav.History}" VerticalAlignment="Center" FontSize="14" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Column="1">
      <!-- Bandeau d'erreur (remplace toute boîte de dialogue). -->
      <Border DockPanel.Dock="Top" Margin="16,12,16,0" Padding="12,8" CornerRadius="6"
              Background="{DynamicResource Pcdoc.Critical.Background}"
              Visibility="{Binding ErrorBanner, Converter={StaticResource NotNullToVisibility}}"
              AutomationProperties.LiveSetting="Assertive">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{app:T Common.Close}" Command="{Binding DismissErrorCommand}"
                  AutomationProperties.Name="{app:T Common.Close}" />
          <TextBlock Text="{Binding ErrorBanner}" Foreground="{DynamicResource Pcdoc.Critical}"
                     TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
      </Border>
      <ContentControl Content="{Binding CurrentViewModel}" Focusable="False" />
    </DockPanel>

    <!-- Assistant du premier lancement : couvre la fenêtre jusqu'à « Commencer ». -->
    <Border Grid.ColumnSpan="2" Background="{DynamicResource ApplicationBackgroundBrush}"
            Visibility="{Binding FirstRun, Converter={StaticResource NotNullToVisibility}}">
      <ContentControl Content="{Binding FirstRun}" Focusable="False" />
    </Border>
  </Grid>
</Window>
