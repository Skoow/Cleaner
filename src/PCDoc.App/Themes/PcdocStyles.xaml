<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Couleurs de gravité : valeurs du thème clair ; ThemeApplier les remplace pour le thème sombre
       et le contraste élevé. La gravité est toujours écrite en toutes lettres à côté de la couleur. -->
  <SolidColorBrush x:Key="Pcdoc.Critical" Color="#C42B1C" />
  <SolidColorBrush x:Key="Pcdoc.Critical.Background" Color="#FDE7E9" />
  <SolidColorBrush x:Key="Pcdoc.Warning" Color="#9D5D00" />
  <SolidColorBrush x:Key="Pcdoc.Warning.Background" Color="#FFF4CE" />
  <SolidColorBrush x:Key="Pcdoc.Ok" Color="#0F7B0F" />
  <SolidColorBrush x:Key="Pcdoc.Ok.Background" Color="#DFF6DD" />

  <FontFamily x:Key="Pcdoc.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Pcdoc.Mono">Cascadia Mono, Consolas</FontFamily>

  <Style x:Key="Pcdoc.PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Pcdoc.SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Pcdoc.Muted" TargetType="TextBlock">
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Pcdoc.Card" TargetType="Border">
    <!-- Pinceaux du thème Fluent (clair/sombre/contraste élevé), pas les couleurs Win32 classiques. -->
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style x:Key="Pcdoc.Pill" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="Pcdoc.Tech" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Pcdoc.Mono}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>
</ResourceDictionary>
