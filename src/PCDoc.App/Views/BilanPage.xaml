<UserControl x:Class="PCDoc.App.Views.BilanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PCDoc.App"
             xmlns:v="clr-namespace:PCDoc.App.Views"
             xmlns:b="clr-namespace:PCDoc.Presentation.Bilan;assembly=PCDoc.Presentation">

  <DockPanel Margin="28,20,28,20">
    <!-- En-tête -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" MinWidth="140" Command="{Binding AnalyzeCommand}" Content="{app:T Bilan.AnalyzeAgain}"
              AutomationProperties.Name="{app:T Bilan.AnalyzeAgain}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="{x:Static b:BilanState.Done}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button DockPanel.Dock="Right" MinWidth="110" Command="{Binding CancelCommand}" Content="{app:T Bilan.Cancel}"
              AutomationProperties.Name="{app:T Bilan.Cancel}">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="{x:Static b:BilanState.Running}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <TextBlock DockPanel.Dock="Right" Text="{Binding CompletedText}" Style="{StaticResource Pcdoc.Muted}" VerticalAlignment="Bottom" Margin="0,0,16,4" />
      <TextBlock Text="{app:T Nav.Bilan}" Style="{StaticResource Pcdoc.PageTitle}" />
    </DockPanel>
    <v:FixPanel DockPanel.Dock="Top" DataContext="{Binding Fixes}"
                        Visibility="{Binding Fixes, Converter={StaticResource NotNullToVisibility}}" />

    <Grid>
      <!-- 1. Avant analyse -->
      <Border VerticalAlignment="Top" Padding="24,48">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Pcdoc.Card}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="{x:Static b:BilanState.Idle}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center" MaxWidth="520">
          <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"
                     Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
          <TextBlock Text="{app:T Bilan.Hero.Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{app:T Bilan.Hero.Text}" Style="{StaticResource Pcdoc.Muted}" TextAlignment="Center" Margin="0,8,0,20" />
          <Button Content="{app:T Bilan.Analyze}" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Center"
                  FontSize="16" Padding="28,10" IsDefault="True" AutomationProperties.Name="{app:T Bilan.Analyze}" />
          <TextBlock Text="{app:T Bilan.NoAnalysis}" Style="{StaticResource Pcdoc.Muted}" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- 2. Analyse en cours -->
      <Border VerticalAlignment="Top" Padding="24,40">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Pcdoc.Card}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="{x:Static b:BilanState.Running}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel MaxWidth="520" HorizontalAlignment="Stretch">
          <TextBlock Text="{app:T Bilan.Running}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" AutomationProperties.Name="{app:T Bilan.Running}" />
          <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type b:ProgressStep}">
                <DockPanel Margin="0,3">
                  <TextBlock x:Name="StepState" DockPanel.Dock="Right" Text="{app:T Bilan.StepRunning}" Style="{StaticResource Pcdoc.Muted}" />
                  <TextBlock Text="{Binding Label}" />
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="StepState" Property="Text" Value="{app:T Bilan.StepDone}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 3. Résultats -->
      <DockPanel>
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="{x:Static b:BilanState.Done}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>

        <!-- Barre d'action en bas -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{app:T Bilan.CopyReport}" Command="{Binding CopyReportCommand}"
                    AutomationProperties.Name="{app:T Bilan.CopyReport}" />
            <Button DockPanel.Dock="Right" Content="{app:T Bilan.FixAllSafe}" Margin="0,0,8,0" Command="{Binding FixAllCommand}"
                    AutomationProperties.Name="{app:T Bilan.FixAllSafe}"
                    Visibility="{Binding AnyFixAvailable, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{app:T Bilan.FooterSafe}" Style="{StaticResource Pcdoc.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <!-- Résumé : anneau de note + compteurs -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Pcdoc.Card}" Margin="0,0,0,12">
          <DockPanel>
            <Grid Width="120" Height="120" Margin="0,0,24,0" AutomationProperties.Name="{Binding ScoreAccessibleName}" Focusable="True">
              <Ellipse Width="100" Height="100" StrokeThickness="10" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
              <Path StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stroke="{Binding Score, Converter={StaticResource ScoreToBrush}}"
                    Data="{Binding Score, Converter={StaticResource ScoreToArc}}" />
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Score}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{app:T Bilan.ScoreOutOf}" FontSize="11" Style="{StaticResource Pcdoc.Muted}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding ScoreLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
              <WrapPanel>
                <Border Style="{StaticResource Pcdoc.Pill}" Background="{DynamicResource Pcdoc.Critical.Background}" Margin="0,0,8,0" Padding="12,4">
                  <TextBlock Text="{Binding CriticalText}" FontWeight="SemiBold" Foreground="{DynamicResource Pcdoc.Critical}" />
                </Border>
                <Border Style="{StaticResource Pcdoc.Pill}" Background="{DynamicResource Pcdoc.Warning.Background}" Margin="0,0,8,0" Padding="12,4">
                  <TextBlock Text="{Binding WarningText}" FontWeight="SemiBold" Foreground="{DynamicResource Pcdoc.Warning}" />
                </Border>
                <Border Style="{StaticResource Pcdoc.Pill}" Background="{DynamicResource Pcdoc.Ok.Background}" Padding="12,4">
                  <TextBlock Text="{Binding InfoText}" FontWeight="SemiBold" Foreground="{DynamicResource Pcdoc.Ok}" />
                </Border>
              </WrapPanel>
              <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Pcdoc.Critical}" Margin="0,10,0,0" TextWrapping="Wrap"
                         Visibility="{Binding ErrorText, Converter={StaticResource NotNullToVisibility}}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Filtre par module -->
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding ModuleFilters}" SelectedValuePath="Id" SelectedValue="{Binding ModuleFilter}"
                 DisplayMemberPath="Label" BorderThickness="0" Background="Transparent" Margin="0,0,0,8"
                 AutomationProperties.Name="{app:T Bilan.FilterLabel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>

        <TextBlock DockPanel.Dock="Top" Text="{app:T Bilan.Empty}" FontSize="16" Margin="0,8"
                   Visibility="{Binding HasNoFindings, Converter={StaticResource BoolToVisibility}}" />

        <!-- Liste des problèmes : chaque ligne se déplie sur le détail technique. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Findings}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type b:FindingRowViewModel}">
                <Border Style="{StaticResource Pcdoc.Card}" Padding="0" Margin="0,0,0,6">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2,0,0,2" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                    <Expander IsExpanded="{Binding IsExpanded}" Padding="12,8" AutomationProperties.Name="{Binding AccessibleName}">
                      <Expander.Header>
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="{app:T Bilan.Fix}" Margin="8,0,0,0"
                                  AutomationProperties.Name="{app:T Bilan.Fix}"
                                  Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding ShowFixButton, Converter={StaticResource BoolToVisibility}}" />
                          <Border DockPanel.Dock="Left" Style="{StaticResource Pcdoc.Pill}" Margin="0,0,12,0"
                                  Background="{Binding Severity, Converter={StaticResource SeverityBackground}}">
                            <TextBlock Text="{Binding SeverityLabel}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                          </Border>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Explanation}" Style="{StaticResource Pcdoc.Muted}" FontSize="13" />
                          </StackPanel>
                        </DockPanel>
                      </Expander.Header>
                      <StackPanel Margin="0,8,0,4">
                        <TextBlock Text="{Binding DetailsHeader}" Style="{StaticResource Pcdoc.Muted}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource Pcdoc.Tech}" Text="{Binding TechnicalDetails, Mode=OneWay}"
                                 AutomationProperties.Name="{Binding DetailsHeader}" />
                        <Button Content="{app:T Common.Copy}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                AutomationProperties.Name="{app:T Common.Copy}"
                                Command="{Binding DataContext.CopyFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Expander>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
