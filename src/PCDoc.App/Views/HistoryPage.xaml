<UserControl x:Class="PCDoc.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PCDoc.App"
             xmlns:h="clr-namespace:PCDoc.Presentation.History;assembly=PCDoc.Presentation">
  <DockPanel Margin="28,20,28,20">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{app:T Nav.History}" Style="{StaticResource Pcdoc.PageTitle}" />
      <TextBlock Text="{app:T History.Intro}" Style="{StaticResource Pcdoc.Muted}" Margin="0,4,0,12" />
      <Border Padding="12" CornerRadius="6" Margin="0,0,0,12" Background="{DynamicResource Pcdoc.Warning.Background}"
              Visibility="{Binding InterruptedText, Converter={StaticResource NotNullToVisibility}}">
        <TextBlock Text="{Binding InterruptedText}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding MessageText, Converter={StaticResource NotNullToVisibility}}" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="{app:T History.ExportReport}" Command="{Binding ExportReportCommand}" Margin="0,0,8,0"
                AutomationProperties.Name="{app:T History.ExportReport}" />
        <Button Content="{app:T History.OpenFolder}" Command="{Binding OpenReportFolderCommand}" AutomationProperties.Name="{app:T History.OpenFolder}"
                Visibility="{Binding CanOpenReport, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </StackPanel>
    <TabControl>
      <TabItem Header="{app:T Nav.History}">
    <DockPanel Margin="0,8,0,0">
      <TextBlock DockPanel.Dock="Top" Text="{app:T History.Empty}" Style="{StaticResource Pcdoc.Muted}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
              GridLinesVisibility="None" AutomationProperties.Name="{app:T Nav.History}"
              EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{app:T Column.Date}" Binding="{Binding Date}" Width="Auto" />
        <DataGridTextColumn Header="{app:T Column.Change}" Binding="{Binding Title}" Width="3*" />
        <DataGridTextColumn Header="{app:T Column.Status}" Binding="{Binding StatusLabel}" Width="Auto" />
        <DataGridTemplateColumn Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type h:HistoryRow}">
              <Button Content="{app:T History.Undo}" Margin="4,2" AutomationProperties.Name="{app:T History.Undo}"
                      Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                      Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    </DockPanel>
      </TabItem>
      <TabItem Header="{app:T History.ActivityTitle}">
        <ListBox ItemsSource="{Binding Activity}" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"
                 AutomationProperties.Name="{app:T History.ActivityTitle}" VirtualizingPanel.IsVirtualizing="True" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
