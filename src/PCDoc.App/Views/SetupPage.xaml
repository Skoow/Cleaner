<UserControl x:Class="PCDoc.App.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PCDoc.App"
             xmlns:v="clr-namespace:PCDoc.App.Views"
             xmlns:s="clr-namespace:PCDoc.Presentation.Setup;assembly=PCDoc.Presentation"
             xmlns:o="clr-namespace:PCDoc.Presentation.Optimize;assembly=PCDoc.Presentation">
  <DockPanel Margin="28,20,28,20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="{app:T Setup.Analyze}" Command="{Binding AnalyzeCommand}" MinWidth="110"
              AutomationProperties.Name="{app:T Setup.Analyze}" />
      <TextBlock Text="{app:T Setup.Title}" Style="{StaticResource Pcdoc.PageTitle}" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{app:T Setup.Intro}" Style="{StaticResource Pcdoc.Muted}" Margin="0,0,0,12" TextWrapping="Wrap" />
    <v:FixPanel DockPanel.Dock="Top" DataContext="{Binding Fixes}" />
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
               AutomationProperties.LiveSetting="Polite" Visibility="{Binding Status, Converter={StaticResource NotNullToVisibility}}" />
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{app:T Setup.Run}" Command="{Binding RunCommand}" MinWidth="180" FontWeight="SemiBold"
              AutomationProperties.Name="{app:T Setup.Run}" />
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="{app:T Setup.Profile}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type o:ProfileChoice}">
                <Button Content="{Binding Label}" Margin="0,0,8,0" MinWidth="100" AutomationProperties.Name="{Binding Label}"
                        Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type s:SetupStep}">
              <Border Style="{StaticResource Pcdoc.Card}" Margin="0,0,0,6" Padding="12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}">
                    <StackPanel Margin="4,0,0,0">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Pcdoc.Muted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{app:T Setup.Software}" FontWeight="SemiBold" Margin="0,12,0,6" />
        <ItemsControl ItemsSource="{Binding Software}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type s:SetupSoftware}">
              <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,16,6" MinWidth="180" AutomationProperties.Name="{Binding Name}"
                        ToolTip="{Binding Category}" Content="{Binding Name}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
