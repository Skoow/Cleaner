<UserControl x:Class="PCDoc.App.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:PCDoc.App"
             xmlns:sp="clr-namespace:PCDoc.Presentation.SystemPage;assembly=PCDoc.Presentation">
  <UserControl.Resources>
    <!-- Une carte : titre + icône, lignes libellé/valeur (pastille pour Windows 11), jauge, note. -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type sp:InfoCard}">
      <Border Style="{StaticResource Pcdoc.Card}" Margin="0,0,12,12" Width="300" VerticalAlignment="Top"
              AutomationProperties.Name="{Binding Title}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Pcdoc.Icons}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
          </StackPanel>
          <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding Gauge, Mode=OneWay, TargetNullValue=0}"
                       Visibility="{Binding Gauge, Converter={StaticResource NotNullToVisibility}}" Margin="0,0,0,4"
                       AutomationProperties.Name="{Binding Note}" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource Pcdoc.Muted}" Margin="0,0,0,6"
                     Visibility="{Binding Note, Converter={StaticResource NotNullToVisibility}}" />
          <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type sp:InfoLine}">
                <DockPanel Margin="0,2">
                  <Border DockPanel.Dock="Right" Style="{StaticResource Pcdoc.Pill}"
                          Background="{Binding State, Converter={StaticResource BadgeBackground}}"
                          Visibility="{Binding State, Converter={StaticResource NotNullToVisibility}}">
                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding State, Converter={StaticResource BadgeBrush}}" />
                  </Border>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="170"
                             Visibility="Collapsed" x:Name="PlainValue" />
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Pcdoc.Muted}" Margin="0,0,12,0" />
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding State}" Value="{x:Null}">
                    <Setter TargetName="PlainValue" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Liste des éléments lancés automatiquement (virtualisée). -->
    <DataTemplate x:Key="AutorunList">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,8">
          <Grid Width="320">
            <TextBox x:Name="Search" Text="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{app:T List.Search}" />
            <TextBlock Text="{app:T List.Search}" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.55">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <ToggleButton Margin="8,0,0,0" Content="{app:T List.UnsignedOnly}" AutomationProperties.Name="{app:T List.UnsignedOnly}"
                        IsChecked="{Binding DataContext.UnsignedOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Pcdoc.Muted}"
                     Text="{Binding DataContext.CountText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
        <DataGrid x:Name="Grid" ItemsSource="{Binding DataContext.Autoruns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel" RowDetailsVisibilityMode="VisibleWhenSelected"
                  AutomationProperties.Name="{Binding DataContext.CountText, RelativeSource={RelativeSource AncestorType=UserControl}}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{app:T Column.Name}" Binding="{Binding Name}" Width="2*" />
            <DataGridTextColumn Header="{app:T Column.Publisher}" Binding="{Binding Publisher}" Width="1.5*" />
            <DataGridTemplateColumn Header="{app:T Column.Signature}" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type sp:AutorunRow}">
                  <Border Style="{StaticResource Pcdoc.Pill}" Background="{Binding Badge, Converter={StaticResource BadgeBackground}}"
                          AutomationProperties.Name="{Binding SignatureLabel}">
                    <TextBlock Text="{Binding SignatureLabel}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding Badge, Converter={StaticResource BadgeBrush}}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{app:T Column.State}" Binding="{Binding StateLabel}" Width="Auto" />
            <DataGridTextColumn Header="{app:T Column.Command}" Binding="{Binding CommandLine}" Width="3*"
                                FontFamily="{StaticResource Pcdoc.Mono}" />
          </DataGrid.Columns>
          <DataGrid.RowDetailsTemplate>
            <DataTemplate DataType="{x:Type sp:AutorunRow}">
              <DockPanel Margin="12,6,12,10">
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="{app:T Common.Copy}"
                        AutomationProperties.Name="{app:T Common.Copy}"
                        Command="{Binding DataContext.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <TextBox Style="{StaticResource Pcdoc.Tech}" Text="{Binding Details, Mode=OneWay}" AutomationProperties.Name="{app:T Column.Command}" />
              </DockPanel>
            </DataTemplate>
          </DataGrid.RowDetailsTemplate>
        </DataGrid>
      </DockPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="28,20,28,20">
    <!-- En-tête -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="{app:T System.Refresh}" Command="{Binding RefreshCommand}" MinWidth="110"
              AutomationProperties.Name="{app:T System.Refresh}" />
      <TextBlock DockPanel.Dock="Right" Text="{app:T System.ReadOnly}" Style="{StaticResource Pcdoc.Muted}" VerticalAlignment="Bottom" Margin="0,0,16,4" />
      <TextBlock Text="{app:T System.Title}" Style="{StaticResource Pcdoc.PageTitle}" />
    </DockPanel>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="{app:T System.Loading}" />

    <TabControl SelectedIndex="{Binding SelectedTab}">
      <!-- 0 Vue d'ensemble -->
      <TabItem Header="{app:T System.Tab.Overview}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
          <ItemsControl ItemsSource="{Binding OverviewCards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <!-- 1 Matériel -->
      <TabItem Header="{app:T System.Tab.Hardware}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
          <ItemsControl ItemsSource="{Binding HardwareCards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <!-- 2 Disques -->
      <TabItem Header="{app:T System.Tab.Disks}">
        <StackPanel Margin="0,12,0,0">
          <DataGrid ItemsSource="{Binding Disks}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    GridLinesVisibility="None" Margin="0,0,0,12" AutomationProperties.Name="{app:T System.Tab.Disks}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{app:T Column.Disk}" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="{app:T Column.Type}" Binding="{Binding Type}" Width="*" />
              <DataGridTextColumn Header="{app:T Column.Size}" Binding="{Binding Size}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
          <DataGrid ItemsSource="{Binding Volumes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    GridLinesVisibility="None" AutomationProperties.Name="{app:T Column.Volume}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{app:T Column.Volume}" Binding="{Binding Letter}" Width="*" />
              <DataGridTextColumn Header="{app:T Column.FileSystem}" Binding="{Binding FileSystem}" Width="*" />
              <DataGridTextColumn Header="{app:T Column.Size}" Binding="{Binding Size}" Width="*" />
              <DataGridTextColumn Header="{app:T Column.Free}" Binding="{Binding Free}" Width="1.5*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{app:T Disks.SmartLater}" Style="{StaticResource Pcdoc.Muted}" Margin="0,12,0,0" />
        </StackPanel>
      </TabItem>
      <!-- 3 Démarrage -->
      <TabItem Header="{app:T System.Tab.Boot}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{app:T Boot.NoData}" Style="{StaticResource Pcdoc.Muted}"
                       Visibility="{Binding HasBootData, Converter={StaticResource InverseBoolToVisibility}}" />
            <StackPanel Visibility="{Binding HasBootData, Converter={StaticResource BoolToVisibility}}">
              <Border Style="{StaticResource Pcdoc.Card}" Margin="0,0,0,16">
                <StackPanel>
                  <WrapPanel Margin="0,0,0,12">
                    <StackPanel Margin="0,0,32,0">
                      <TextBlock Text="{Binding LastBootText}" FontSize="24" FontWeight="SemiBold" />
                      <TextBlock Text="{app:T Boot.Last}" Style="{StaticResource Pcdoc.Muted}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,32,0">
                      <TextBlock Text="{Binding MedianText}" FontSize="24" FontWeight="SemiBold" />
                      <TextBlock Text="{app:T Boot.Median}" Style="{StaticResource Pcdoc.Muted}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding TrendText}" FontSize="24" FontWeight="SemiBold" />
                      <TextBlock Text="{app:T Boot.TrendLabel}" Style="{StaticResource Pcdoc.Muted}" />
                    </StackPanel>
                  </WrapPanel>
                  <!-- Graphique des démarrages : une barre par démarrage, le plus récent à droite. -->
                  <ItemsControl ItemsSource="{Binding BootBars}" Height="170" Focusable="False"
                                AutomationProperties.Name="{Binding BootChartDescription}"
                                ToolTip="{Binding BootChartDescription}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1" VerticalAlignment="Bottom" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type sp:BootBar}">
                        <Rectangle x:Name="Bar" Margin="2,0" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom"
                                   Height="{Binding Ratio, Converter={StaticResource RatioToLength}, ConverterParameter=160}"
                                   Fill="{DynamicResource AccentFillColorDefaultBrush}" ToolTip="{Binding Tooltip}" />
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsLast}" Value="True">
                            <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Pcdoc.Warning}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding BootChartDescription}" Style="{StaticResource Pcdoc.Muted}" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <TextBlock Text="{app:T Boot.Degradations}" Style="{StaticResource Pcdoc.SectionTitle}" />
              <DataGrid ItemsSource="{Binding LastDegradations}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="None" AutomationProperties.Name="{app:T Boot.Degradations}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{app:T Column.Item}" Binding="{Binding Name}" Width="2*" />
                  <DataGridTextColumn Header="{app:T Column.Type}" Binding="{Binding Kind}" Width="*" />
                  <DataGridTextColumn Header="{app:T Column.Delay}" Binding="{Binding Delay}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- 4, 5, 6 : listes (le ViewModel filtre selon l'onglet) -->
      <TabItem Header="{app:T System.Tab.Startup}">
        <ContentControl ContentTemplate="{StaticResource AutorunList}" Content="{Binding}" Focusable="False" />
      </TabItem>
      <TabItem Header="{app:T System.Tab.Tasks}">
        <ContentControl ContentTemplate="{StaticResource AutorunList}" Content="{Binding}" Focusable="False" />
      </TabItem>
      <TabItem Header="{app:T System.Tab.Services}">
        <ContentControl ContentTemplate="{StaticResource AutorunList}" Content="{Binding}" Focusable="False" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
