{
  "version": 1,
  "note": "Catégories de nettoyage. root : %SystemRoot%, %ProgramData% ou %LOCALAPPDATA% (profil cible) ; « * » dans un segment = tous les sous-dossiers (profils de navigateur). risk : Safe | Conditional. Seuls les fichiers sont supprimés. files : fichiers précis, « * » permis dans les dossiers et le nom. requiresClosed : programmes qui doivent être fermés (navigateurs).",
  "categories": [
    {
      "id": "windows-temp",
      "roots": [
        "%SystemRoot%\\Temp"
      ],
      "minAgeHours": 24,
      "risk": "Safe"
    },
    {
      "id": "user-temp",
      "roots": [
        "%LOCALAPPDATA%\\Temp"
      ],
      "minAgeHours": 24,
      "risk": "Safe"
    },
    {
      "id": "wu-download",
      "roots": [
        "%SystemRoot%\\SoftwareDistribution\\Download"
      ],
      "minAgeHours": 24,
      "risk": "Safe",
      "requiresIdleWindowsUpdate": true
    },
    {
      "id": "error-reports",
      "roots": [
        "%ProgramData%\\Microsoft\\Windows\\WER\\ReportArchive",
        "%ProgramData%\\Microsoft\\Windows\\WER\\ReportQueue"
      ],
      "minAgeHours": 0,
      "risk": "Safe"
    },
    {
      "id": "crash-dumps",
