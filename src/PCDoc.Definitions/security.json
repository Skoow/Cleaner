        { "hive": "LocalMachine", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "NoDriveTypeAutoRun", "dword": 255 },
        { "hive": "LocalMachine", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "NoAutorun", "dword": 1 } ] },
    { "id": "smartscreen-on", "risk": "Safe", "severity": "Warning", "bilan": true, "absentIsApplied": true,
