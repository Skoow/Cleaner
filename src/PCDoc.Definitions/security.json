        { "hive": "LocalMachine", "path": "SOFTWARE\\WOW6432Node\\Microsoft\\Windows NT\\CurrentVersion\\Windows", "name": "LoadAppInit_DLLs", "dword": 0 } ] },
    { "id": "winlogon-shell", "risk": "Safe", "severity": "Critical", "bilan": true, "absentIsApplied": true,
      "values": [ { "hive": "LocalMachine", "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon", "name": "Shell", "text": "explorer.exe", "acceptableTexts": ["C:\\Windows\\explorer.exe", "%SystemRoot%\\explorer.exe", "%windir%\\explorer.exe"] } ] },
    { "id": "wdigest-off", "risk": "Safe", "severity": "Warning", "bilan": true, "absentIsApplied": true,
